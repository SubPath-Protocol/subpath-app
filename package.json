{
  "name": "subpath-workspace",
  "private": true,
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "db:generate": "pnpm --filter indexer db:generate",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "pnpm db:generate && pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "unrs-resolver",
      "sodium-native",
      "@stellar/stellar-base"
    ]
  }
}
